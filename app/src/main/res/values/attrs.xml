<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="RippleBackground">
        <attr name="rb_color" format="color" />
        <attr name="rb_strokeWidth" format="dimension"/>
        <attr name="rb_radius" format="dimension"/>
        <attr name="rb_duration" format="integer"/>
        <attr name="rb_rippleAmount" format="integer"/>
        <attr name="rb_scale" format="float"/>
        <attr name="rb_type" format="enum">
            <enum name="fillRipple" value="0"/>
            <enum name="strokeRipple" value="1"/>
        </attr>
    </declare-styleable>
    <declare-styleable name="customTheme">
        <attr name="colorBackground" format="color|reference" />
        <attr name="colorOnBackground1" format="color|reference" />
        <attr name="colorOnBackground2" format="color|reference" />
        <attr name="colorOnBackground3" format="color|reference" />
        <attr name="colorBackgroundContainer" format="color|reference" />
        <attr name="colorOnBackgroundContainer1" format="color|reference" />
        <attr name="colorOnBackgroundContainer2" format="color|reference" />
        <attr name="colorSurface" format="color|reference" />
        <attr name="colorOnSurface1" format="color|reference" />
        <attr name="colorOnSurface2" format="color|reference" />
        <attr name="colorOnSurface3" format="color|reference" />
        <attr name="colorAccent" format="color|reference" />
        <attr name="colorOnAccent" format="color|reference" />
        <attr name="colorTopBarGradStart" format="color|reference" />
        <attr name="colorTopBarGradEnd" format="color|reference" />
        <attr name="colorOnTopBar" format="color|reference" />
        <attr name="colorTopBarContainer" format="color|reference" />
        <attr name="colorOnTopBarContainer1" format="color|reference" />
        <attr name="colorOnTopBarContainer2" format="color|reference" />
        <attr name="colorButtonGradStart" format="color|reference" />
        <attr name="colorButtonGradEnd" format="color|reference" />
        <attr name="colorOnButton" format="color|reference" />
        <attr name="colorTopBarContainerGradStart" format="reference|color"/>
        <attr name="colorTopBarContainerGradEnd" format="reference|color"/>
        <attr name="transparent" format="reference|color"/>
    </declare-styleable>
</resources>