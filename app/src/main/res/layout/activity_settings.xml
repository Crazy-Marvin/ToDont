    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:elevation="5dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/backUpButton"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content">
            <ImageButton
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:layout_marginStart="20dp"
                android:background="@drawable/frame__4_"
                android:elevation="6dp"
                android:gravity="bottom"
          />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginStart="20dp"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:text="@string/back_up"
                android:textColor="?attr/colorOnBackground1"
                android:textSize="16sp"

                />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="64dp"
            android:layout_marginTop="20dp"
            android:background="?attr/colorOnBackground3" />



    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:elevation="5dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/restoreButton"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:onClick="restore"
            android:layout_height="wrap_content">
            <ImageButton
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:layout_marginStart="20dp"
                android:background="@drawable/frame__5_"
                android:elevation="6dp"
                android:gravity="bottom"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginStart="20dp"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:text="@string/restore"
                android:textColor="?attr/colorOnBackground1"
                android:textSize="16sp"

                />
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:elevation="6dp"

            android:gravity="bottom"
            android:onClick="changeMode"
            android:text="@string/about"
            android:textColor="?attr/colorPrimary"
            android:textSize="16sp"

            />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="?attr/colorOnBackground3" />




    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:elevation="5dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content">
            <ImageButton
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:layout_marginStart="20dp"
                android:background="@drawable/about"
                android:elevation="6dp"
                android:gravity="bottom"
                android:onClick="aboutus" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginStart="20dp"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:onClick="aboutus"
                android:text="@string/about"
                android:textColor="?attr/colorOnBackground1"
                android:textSize="16sp"

                />
        </LinearLayout>



    </LinearLayout>


</LinearLayout>