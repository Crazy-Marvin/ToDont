<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:id="@+id/settings_main"
    android:orientation="vertical"
    tools:context=".Settings">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/gradient_background"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:layout_marginStart="20dp"
            android:background="@drawable/ic_back"
            android:elevation="6dp"
            android:gravity="bottom"
            android:onClick="backBtn" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:layout_marginBottom="3dp"
            android:textSize="20sp"
            android:layout_marginStart="20dp"
            android:gravity="bottom"
            android:text="@string/settings"
            android:textColor="?attr/colorOnTopBar"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/appearanceView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:layout_marginStart="20dp"
            android:background="@drawable/dis"
            android:elevation="6dp"
            android:gravity="bottom"
            android:onClick="changeMode" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:onClick="changeMode"
                android:text="@string/appearance"
                android:textColor="?attr/colorOnBackground1"
                android:textSize="16sp"

                />

            <TextView
                android:id="@+id/modetitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:onClick="changeMode"
                android:layout_marginTop="4dp"
                android:textColor="?attr/colorOnBackground2"
                android:textSize="14sp"
                android:text="light"
                />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/monitorView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <!-- Monitor Icon -->
        <ImageButton
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="20dp"
            android:background="@drawable/monitor"
            android:contentDescription="@string/monitor_error"
            android:elevation="6dp"
            android:onClick="changeMode" />

        <!-- Text -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:onClick="changeMode"
            android:text="@string/monitor_error"
            android:textColor="?attr/colorOnBackground1"
            android:textSize="16sp"
            android:layout_weight="1" />

        <!-- Right-side container (info + radio) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical|end"
            android:paddingEnd="20dp">

            <!-- Info Icon -->
            <ImageButton
                android:id="@+id/monitor_info_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/info"
                android:elevation="6dp"
                android:contentDescription="@string/monitor_error"
                android:onClick="changeMode" />

            <!-- Radio Button -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/monitorSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp" />
        </LinearLayout>

    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:elevation="6dp"
            android:gravity="bottom"
            android:onClick="changeMode"
            android:text="@string/data"
            android:textColor="?attr/colorAccent"
            android:textSize="16sp"
            />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="?attr/colorOnBackground3" />

    </LinearLayout>



